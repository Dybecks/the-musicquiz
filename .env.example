# Optional: overrides the game's built-in Spotify Client ID (src/spotify/auth.ts).
# Client ID of an app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Optional: your own PeerJS server for playing together on phones (default: the public 0.peerjs.com).
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=
